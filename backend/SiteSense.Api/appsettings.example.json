{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379,abortConnect=false"
  },
  "Store": {
    "RootPath": ".store"
  },
  "Tracking": {
    "VMaxMps": 7,
    "ResetAfter": 3,
    "AreaMarginM": 2,
    "AreaConfirmPoints": 3
  },
  "Tenants": {
    "tenant-a": { "RetentionDays": 30, "SilentAfterMinutes": 10 },
    "tenant-b": { "RetentionDays": 30, "SilentAfterMinutes": 10 }
  },
  "Auth": {
    "Issuer": "http://localhost:8081/realms/sitesense",
    "Audience": "sitesense-api",
    "RequireHttpsMetadata": false,
    "UiOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  }
}
